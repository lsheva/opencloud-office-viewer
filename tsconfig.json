{
  "extends": "@opencloud-eu/tsconfig",
  "compilerOptions": {
    "types": ["vite/client"],
    "noEmit": true,
  },
  "contentMappers": [
    {
      "package": "@vue/content-mapper",
      "extensions": [".vue"],
      "options": { "target": 3.5 },
    },
  ],
  "include": ["src/**/*.ts", "src/**/*.vue"],
}
